{
  "name": "@retronew/call-vue",
  "version": "0.3.0",
  "description": "Call & await Vue components like async functions — a Vue 3 port of react-call.",
  "keywords": [
    "async",
    "composable",
    "confirm",
    "dialog",
    "modal",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/retronew/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/retronew/ui-kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retronew/ui-kit.git",
    "directory": "packages/call-vue"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./mutation-flow": "./src/mutation-flow/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./mutation-flow": {
        "types": "./dist/mutation-flow/index.d.mts",
        "default": "./dist/mutation-flow/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
