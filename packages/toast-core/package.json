{
  "name": "@retronew/toast-core",
  "version": "0.4.0",
  "description": "Framework-agnostic headless toast state machine — the core powering @retronew toast adapters.",
  "keywords": [
    "framework-agnostic",
    "headless",
    "notifications",
    "toast"
  ],
  "homepage": "https://github.com/retronew/ui-kit#readme",
  "bugs": {
    "url": "https://github.com/retronew/ui-kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retronew/ui-kit.git",
    "directory": "packages/toast-core"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
