---
import Base from '~/layouts/Base.astro'

const concepts = [
  { href: '/concepts/root-and-stack', title: 'Root & Stack', description: 'Where a Callable lives in the Vue tree and what happens when many calls are active at once.' },
  { href: '/concepts/call-and-end', title: 'Call & End', description: 'How props enter a call, how its Promise resolves, and how targeted and broadcast ending differ.' },
  { href: '/concepts/upsert-and-update', title: 'Upsert & Update', description: 'Singleton calls, stable Promise identity, and targeted or broadcast prop updates.' },
  { href: '/concepts/mutation-flow', title: 'Mutation flow', description: 'Pending state, duplicate-submit protection, retries, and an explicit close on success.' },
  { href: '/concepts/exit-lifecycle', title: 'Exit lifecycle', description: 'The ended flag, delayed unmounting, animation timing, and race-free cleanup.' },
]
---

<Base title="Concepts — call-vue" description="The core mental model behind call-vue.">
  <div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-medium tracking-tight text-[var(--color-fg)] md:text-5xl">Concepts</h1>
    <p class="mt-3 text-base leading-7 text-[var(--color-fg-muted)]">Five lenses on the mental model, from the single Root to async submission and the final delayed unmount.</p>
    <div class="mt-12 grid gap-4">
      {concepts.map((concept) => <a href={concept.href} class="group flex flex-col gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-subtle)] p-5 shadow-sm shadow-black/3 transition-[border-color,transform] hover:border-[var(--color-accent)]"><h2 class="text-lg font-medium text-[var(--color-fg)] transition-colors group-hover:text-[var(--color-accent)]">{concept.title}</h2><p class="text-sm leading-6 text-[var(--color-fg-muted)]">{concept.description}</p></a>)}
    </div>
  </div>
</Base>
