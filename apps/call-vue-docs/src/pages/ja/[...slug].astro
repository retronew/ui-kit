---
import LocalizedSlugPage from '~/components/LocalizedSlugPage.astro'
import { localizedDocs } from '~/localized-docs'

export function getStaticPaths() {
  return Object.keys(localizedDocs.ja)
    .filter((slug) => slug !== 'api')
    .map((slug) => ({ params: { slug } }))
}

const slug = Astro.params.slug ?? ''
---

<LocalizedSlugPage locale="ja" slug={slug} />
