---
import Base from './Base.astro'
import { localizePath, shellMessages } from '~/i18n'
import type { Locale } from '~/i18n'
import { localizedDocs } from '~/localized-docs'

interface Props {
  title: string
  intro: string
  locale?: Locale
}

const { title, intro, locale = 'en' } = Astro.props

const conceptSlugs = [
  'concepts/root-and-stack',
  'concepts/call-and-end',
  'concepts/upsert-and-update',
  'concepts/mutation-flow',
  'concepts/exit-lifecycle',
] as const

const englishLabels: Record<(typeof conceptSlugs)[number], string> = {
  'concepts/root-and-stack': 'Root & Stack',
  'concepts/call-and-end': 'Call & End',
  'concepts/upsert-and-update': 'Upsert & Update',
  'concepts/mutation-flow': 'Mutation flow',
  'concepts/exit-lifecycle': 'Exit lifecycle',
}

const sections = conceptSlugs.map((slug) => ({
  href: localizePath(`/${slug}`, locale),
  label: locale === 'en' ? englishLabels[slug] : localizedDocs[locale][slug].title,
}))

const conceptsHref = localizePath('/concepts', locale)
const conceptsLabel = shellMessages[locale].nav.concepts
const current = Astro.url.pathname.replace(/\/$/, '')
---

<Base title={`${title} — call-vue`} description={intro} type="article">
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-16">
    <nav class="mb-8 font-mono text-xs text-[var(--color-fg-subtle)]" aria-label="Breadcrumb">
      <a href={localizePath('/', locale)} class="underline-offset-2 transition-colors hover:text-[var(--color-fg-muted)] hover:underline">Home</a><span class="px-2">/</span><a href={conceptsHref} class="text-[var(--color-fg-muted)] underline-offset-2 hover:underline">{conceptsLabel}</a>
    </nav>
    <header class="mb-10">
      <h1 class="text-3xl leading-[1.1] font-medium tracking-[-0.025em] text-[var(--color-fg)] md:text-5xl">{title}</h1>
      <p class="mt-3 max-w-2xl text-base leading-7 text-[var(--color-fg-muted)]">{intro}</p>
    </header>
    <nav class="-mx-6 mb-8 flex overflow-x-auto border-y border-[var(--color-border)] bg-[var(--color-bg-subtle)] md:hidden" aria-label="Concept sections">
      <div class="flex gap-1 px-6 py-2">
        {sections.map((section) => <a href={section.href} class={current === section.href ? 'shrink-0 rounded-full border border-[var(--color-accent)] bg-[var(--color-bg)] px-3 py-2 text-xs font-medium text-[var(--color-accent)]' : 'shrink-0 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-xs text-[var(--color-fg-muted)]'}>{section.label}</a>)}
      </div>
    </nav>
    <div class="grid gap-12 md:grid-cols-[200px_1fr]">
      <aside class="hidden md:block">
        <p class="mb-3 font-mono text-xs uppercase tracking-wider text-[var(--color-fg-subtle)]">{conceptsLabel}</p>
        <ul class="space-y-1">
          {sections.map((section) => <li><a href={section.href} class={current === section.href ? 'block rounded px-2 py-1 text-sm text-[var(--color-accent)]' : 'block rounded px-2 py-1 text-sm text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-fg)]'}>{section.label}</a></li>)}
        </ul>
      </aside>
      <article class="prose-call-vue min-w-0 max-w-[70ch] space-y-6 text-[var(--color-fg-muted)]"><slot /></article>
    </div>
  </div>
</Base>
