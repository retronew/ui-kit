---
import callVuePackage from '@retronew/call-vue/package.json'
import { getLocaleFromPath, localizePath, shellMessages } from '~/i18n'
import type { Locale } from '~/i18n'
import { formatStarCount, getStarCount } from '~/lib/github'
import LanguageSwitcher from './LanguageSwitcher.astro'
import MobileNav from './MobileNav.vue'
import ThemeToggle from './ThemeToggle.vue'

const starsLabel = formatStarCount(await getStarCount())
interface Props { locale?: Locale }
const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname)
const messages = shellMessages[locale]
const versionLabel = `v${callVuePackage.version.split('.').slice(0, 2).join('.')}`
const navItems = [
  { href: localizePath('/why', locale), label: messages.nav.why },
  { href: localizePath('/examples', locale), label: messages.nav.examples },
  { href: localizePath('/concepts', locale), label: messages.nav.concepts },
]
const referenceLink = {
  href: localizePath('/api', locale),
  label: messages.nav.reference,
  external: false,
}
const mobileLinks = [...navItems, referenceLink]
---

<header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-bg)_85%,transparent)] backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href={localizePath('/', locale)} class="relative top-px flex shrink-0 items-center font-mono text-sm font-medium whitespace-nowrap text-[var(--color-fg)]">
      <span class="flex items-start gap-1">
        <span>call-vue<span class="text-[var(--color-accent)]" aria-hidden="true">()</span></span>
        <span class="text-xs font-normal leading-none text-[var(--color-fg-subtle)]">{versionLabel}</span>
      </span>
    </a>

    <nav class="flex items-center gap-3 sm:gap-6">
      <div class="hidden items-center gap-6 md:flex">
        {navItems.map((item) => (
          <a href={item.href} class="text-sm text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-fg)]">{item.label}</a>
        ))}
        <a href={referenceLink.href} class="whitespace-nowrap text-sm text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-fg)]">
          {referenceLink.label}
        </a>
      </div>

      <a
        href="https://github.com/retronew/ui-kit"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${messages.star} — ${starsLabel}`}
        class="group inline-flex h-9 items-stretch overflow-hidden rounded-md border border-[var(--color-border-strong)] text-sm text-[var(--color-fg-muted)] transition-[color,background-color,transform] hover:bg-[var(--color-bg-muted)] hover:text-[var(--color-fg)] md:h-auto md:hover:bg-transparent"
      >
        <span class="flex items-center gap-1.5 pl-2.5 pr-1 transition-colors md:px-3 md:py-1.5 md:group-hover:bg-[var(--color-bg-muted)]">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5 text-[var(--color-accent)]">
            <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"></path>
          </svg>
          <span class="hidden md:inline">GitHub</span>
        </span>
        <span class="flex items-center tabular-nums pl-1 pr-2.5 md:border-l md:border-[var(--color-border-strong)] md:bg-[var(--color-bg-muted)] md:px-2.5 md:py-1.5">{starsLabel}</span>
      </a>
      <ThemeToggle client:load />
      <LanguageSwitcher locale={locale} pathname={Astro.url.pathname} label={messages.language} />
      <div class="md:hidden"><MobileNav links={mobileLinks} client:load /></div>
    </nav>
  </div>
</header>
