---
import { Code } from 'astro-expressive-code/components'
import { localizePath } from '~/i18n'
import type { Locale } from '~/i18n'
import { localizedDocs } from '~/localized-docs'
import ConceptsGrid from '~/components/ConceptsGrid.astro'
import ExamplesGrid from '~/components/ExamplesGrid.astro'
import WhyContent from '~/components/WhyContent.astro'
import Concept from '~/layouts/Concept.astro'
import Base from '~/layouts/Base.astro'
import StackConceptDemo from '~/components/concepts/StackConceptDemo.vue'
import MutationFlowConceptDemo from '~/components/concepts/MutationFlowConceptDemo.vue'
import UpsertConceptDemo from '~/components/concepts/UpsertConceptDemo.vue'

interface Props {
  locale: Exclude<Locale, 'en'>
  slug: string
}

const { locale, slug } = Astro.props
const doc = localizedDocs[locale][slug]
if (!doc) throw new Error(`Missing localized document: ${locale}/${slug}`)

// Index (0-based) of the section after which the English page embeds a live
// demo — keep these positions in sync with src/pages/concepts/*.astro.
const demoAfterSection: Record<string, number> = {
  'concepts/root-and-stack': 1,
  'concepts/mutation-flow': 0,
  'concepts/upsert-and-update': 0,
}
const demoIndex = demoAfterSection[slug]
---

{slug === 'why' && (
  <Base title={`${doc.title} — call-vue`} description={doc.description} type="article">
    <WhyContent locale={locale} />
  </Base>
)}
{slug === 'concepts' && <ConceptsGrid locale={locale} />}
{slug === 'examples' && <ExamplesGrid locale={locale} />}
{slug.startsWith('concepts/') && (
  <Concept title={doc.title} intro={doc.description} locale={locale}>
    {doc.sections.map((section, i) => (
      <>
        <section>
          {section.codeHeading ? <h2><code>{section.heading}</code></h2> : <h2>{section.heading}</h2>}
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
          {section.code && <Code code={section.code} lang={section.lang ?? 'ts'} meta={section.meta} />}
        </section>
        {i === demoIndex && slug === 'concepts/root-and-stack' && <div class="demo"><StackConceptDemo client:load locale={locale} /></div>}
        {i === demoIndex && slug === 'concepts/mutation-flow' && <div class="demo"><MutationFlowConceptDemo client:load locale={locale} /></div>}
        {i === demoIndex && slug === 'concepts/upsert-and-update' && <div class="demo"><UpsertConceptDemo client:load locale={locale} /></div>}
      </>
    ))}
  </Concept>
)}
{!['why', 'concepts', 'examples'].includes(slug) && !slug.startsWith('concepts/') && (
  <Base title={`${doc.title} — call-vue`} description={doc.description} type="article">
    <div class="mx-auto max-w-3xl px-6 py-12 md:py-16">
      <nav class="mb-8 font-mono text-xs text-[var(--color-fg-subtle)]" aria-label="Breadcrumb"><a href={localizePath('/', locale)} class="underline-offset-2 hover:underline">Home</a><span class="px-2">/</span><span class="text-[var(--color-fg-muted)]">{doc.title}</span></nav>
      <header class="mb-10"><h1 class="text-3xl leading-[1.1] font-medium tracking-[-0.025em] text-[var(--color-fg)] md:text-5xl">{doc.title}</h1><p class="mt-4 max-w-2xl text-base leading-7 text-[var(--color-fg-muted)]">{doc.description}</p></header>
      <article class="prose-call-vue max-w-[70ch] space-y-6 text-[var(--color-fg-muted)]">
        {doc.sections.map((section) => (
          <section>
            {section.codeHeading ? <h2><code>{section.heading}</code></h2> : <h2>{section.heading}</h2>}
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
            {section.code && <Code code={section.code} lang={section.lang ?? 'ts'} meta={section.meta} />}
          </section>
        ))}
      </article>
    </div>
  </Base>
)}
